                <div class="info-value">{{ $message->created_at->format('h:i A') }}</div>
            </div>
            <div class="info-row">
                <div class="info-label">{{ __('Last Updated') }}</div>
                <div class="info-value">{{ $message->updated_at->diffForHumans() }}</div>
