                <i class="fas fa-tools"></i>
                {{ __('Actions') }}
            </h2>
            <div class="action-buttons">
                <!-- Reply via Email -->
                <a href="mailto:{{ $message->email }}?subject=Re: {{ urlencode($message->subject) }}" class="btn btn-primary">
                    <i class="fas fa-reply"></i>
                    {{ __('Reply via Email') }}
                </a>

                <!-- Update Status Forms -->
                @if($message->status !== 'read')
                <form action="{{ route('admin.contacts.update-status', $message->id) }}" method="POST">
                    @csrf
                    @method('PATCH')
                    <input type="hidden" name="status" value="read">
                    <button type="submit" class="btn btn-success" style="width: 100%;">
                        <i class="fas fa-check"></i>
                        {{ __('Mark as Read') }}
                    </button>
                </form>
                @endif

                @if($message->status !== 'archived')
                <form action="{{ route('admin.contacts.update-status', $message->id) }}" method="POST">
                    @csrf
                    @method('PATCH')
                    <input type="hidden" name="status" value="archived">
                    <button type="submit" class="btn btn-secondary" style="width: 100%;">
                        <i class="fas fa-archive"></i>
                        {{ __('Archive Message') }}
                    </button>
                </form>
                @endif

                @if($message->status === 'archived')
                <form action="{{ route('admin.contacts.update-status', $message->id) }}" method="POST">
                    @csrf
                    @method('PATCH')
                    <input type="hidden" name="status" value="read">
                    <button type="submit" class="btn btn-success" style="width: 100%;">
                        <i class="fas fa-undo"></i>
                        {{ __('Unarchive') }}
                    </button>
                </form>
                @endif

                <!-- Delete -->
                <form action="{{ route('admin.contacts.destroy', $message->id) }}" method="POST" onsubmit="return confirm('{{ __('Are you sure you want to delete this message?') }}')">
                    @csrf
                    @method('DELETE')
                    <button type="submit" class="btn btn-danger" style="width: 100%;">
                        <i class="fas fa-trash"></i>
                        {{ __('Delete Message') }}
                    </button>
                </form>
            </div>
        </div>

        <!-- Message Info Card -->
        <div class="card" style="margin-top: 1.5rem;">
            <h2 class="card-title">
                <i class="fas fa-info-circle"></i>
                {{ __('Message Info') }}
